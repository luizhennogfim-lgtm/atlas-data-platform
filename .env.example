# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit .env. Never reuse these values elsewhere.
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_dev_only
POSTGRES_DB=atlas
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_dev_only

# Used when running the CLI on your machine (outside Docker)
ATLAS_DB_DSN=postgresql://atlas:atlas_dev_only@localhost:5432/atlas
# ATLAS_SOURCE_DIR=data/sample
# ATLAS_WARN_REJECT_RATE=0.01
# ATLAS_CRITICAL_REJECT_RATE=0.20

# Optional S3 export of the quality report (needs: pip install ".[aws]" and AWS credentials)
# ATLAS_S3_BUCKET=
